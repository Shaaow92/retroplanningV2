:root {
  --bg: #fafafa;
  --surface: #ffffff;
  --surface-subtle: #f4f4f5;
  --text: #171717;
  --text-secondary: #525252;
  --muted: #737373;
  --border: rgba(23, 23, 23, 0.08);
  --border-strong: rgba(23, 23, 23, 0.16);
  --primary: #ea580c;
  --primary-hover: #c2410c;
  --primary-soft: #fff7ed;
  --primary-border: rgba(234, 88, 12, 0.24);
  --shadow-sm: 0 1px 2px rgba(23, 23, 23, 0.05);
  --shadow-md: 0 8px 24px rgba(23, 23, 23, 0.06);
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --ease: cubic-bezier(0.22, 1, 0.36, 1);
}

* { box-sizing: border-box; }
[hidden] { display: none !important; }

body {
  margin: 0;
  font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  font-size: 14px;
  font-weight: 400;
  background: var(--bg);
  color: var(--text);
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
  -webkit-font-smoothing: antialiased;
}

/* --- AUTHENTIFICATION --- */
.auth-shell {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: var(--bg);
}

.auth-card {
  width: 100%;
  max-width: 420px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: var(--shadow-md);
}

.auth-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
}

.auth-logo {
  height: 44px;
  width: auto;
  object-fit: contain;
}

.auth-brand h1 {
  margin: 0;
  font-size: 20px;
  line-height: 1.25;
  font-weight: 500;
  color: var(--text);
}

.auth-brand p {
  margin: 4px 0 0;
  font-size: 13px;
  font-weight: 400;
  color: var(--muted);
}

.auth-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: var(--surface-subtle);
  padding: 4px;
  border-radius: var(--radius-sm);
  margin-bottom: 16px;
}

.auth-tab {
  border: none;
  background: transparent;
  padding: 8px 12px;
  font-size: 13px;
  font-weight: 500;
  color: var(--text-secondary);
  border-radius: 6px;
  cursor: pointer;
  transition: color 150ms var(--ease), background-color 150ms var(--ease);
}

.auth-tab.active {
  background: var(--surface);
  color: var(--text);
  box-shadow: var(--shadow-sm);
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.auth-feedback {
  font-size: 13px;
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  font-weight: 500;
}
.auth-feedback.error {
  background: #fef2f2;
  color: #b91c1c;
  border: 1px solid rgba(185, 28, 28, 0.2);
}
.auth-feedback.success {
  background: #f0fdf4;
  color: #15803d;
  border: 1px solid rgba(21, 128, 61, 0.2);
}

/* --- TOPBAR --- */
.topbar {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 20;
}

.topbar-inner {
  max-width: 1240px;
  margin: 0 auto;
  padding: 12px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-logo-img {
  height: 36px;
  width: auto;
  object-fit: contain;
  display: block;
}

.brand strong {
  color: var(--text);
  font-size: 16px;
  font-weight: 500;
  line-height: 1.2;
}

.brand small {
  display: block;
  color: var(--muted);
  font-weight: 400;
  font-size: 12px;
  line-height: 1.35;
}

.nav {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
}

.nav a {
  text-decoration: none;
  color: var(--text-secondary);
  font-weight: 500;
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  transition: color 150ms var(--ease), background-color 150ms var(--ease);
}

.nav a.active {
  background: var(--primary-soft);
  color: var(--primary);
}

.nav a:hover:not(.active) {
  background: var(--surface-subtle);
  color: var(--text);
}

.user-menu {
  display: flex;
  align-items: center;
  gap: 8px;
}

.user-pill {
  font-size: 12px;
  font-weight: 500;
  color: var(--text-secondary);
  background: var(--surface-subtle);
  padding: 4px 12px;
  border-radius: 6px;
  border: 1px solid var(--border);
}

/* --- LAYOUT & EN-TÊTE --- */
.wrap {
  max-width: 1240px;
  margin: 0 auto;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.page-header h1 {
  margin: 0;
  font-size: 28px;
  line-height: 1.2;
  font-weight: 500;
  letter-spacing: -0.015em;
  color: var(--text);
}

.page-header p {
  margin: 4px 0 0;
  font-size: 14px;
  font-weight: 400;
  color: var(--text-secondary);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.toast-banner {
  background: var(--primary-soft);
  border: 1px solid var(--primary-border);
  color: var(--primary-hover);
  padding: 12px 16px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  font-weight: 500;
}

.layout {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  gap: 20px;
  align-items: stretch;
}

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 20px;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
}

.card-head h2 {
  margin: 0;
  font-size: 16px;
  line-height: 1.3;
  font-weight: 500;
  color: var(--text);
}

.card-subtitle {
  margin: 4px 0 0;
  font-size: 13px;
  color: var(--muted);
}

.muted-count {
  font-size: 12px;
  font-weight: 500;
  color: var(--muted);
  background: var(--surface-subtle);
  padding: 4px 8px;
  border-radius: 6px;
  border: 1px solid var(--border);
}

.badge-info {
  background: var(--surface-subtle);
  color: var(--text-secondary);
  border: 1px solid var(--border);
  font-weight: 500;
  font-size: 12px;
  padding: 4px 10px;
  border-radius: 6px;
}

.hint-text {
  font-size: 12px;
  color: var(--muted);
  font-weight: 400;
}

/* --- CALENDRIER --- */
.cal-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
}

table.cal {
  width: 100%;
  height: 100%;
  border-collapse: collapse;
  table-layout: fixed;
  border-radius: var(--radius-sm);
  overflow: hidden;
  border: 1px solid var(--border);
}

table.cal th {
  font-size: 12px;
  font-weight: 500;
  color: var(--text-secondary);
  background: var(--surface-subtle);
  padding: 8px 4px;
  border-bottom: 1px solid var(--border);
  border-right: 1px solid var(--border);
}

table.cal td {
  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  height: 88px;
  vertical-align: top;
  padding: 4px;
  background: var(--surface);
  transition: background-color 140ms var(--ease);
}

table.cal td.blank {
  background: var(--surface-subtle);
}

table.cal td.active-range {
  background: var(--primary-soft);
  box-shadow: inset 0 2px 0 var(--primary);
}

.dnum {
  font-size: 12px;
  font-weight: 500;
  margin-bottom: 4px;
  color: var(--text-secondary);
}

.mark {
  width: 100%;
  border: none;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 500;
  padding: 4px 8px;
  margin-bottom: 4px;
  text-align: left;
  cursor: pointer;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: opacity 140ms var(--ease), transform 120ms var(--ease);
}

.mark:hover {
  opacity: 0.92;
}

.mark:active {
  transform: scale(0.98);
}

/* --- PANNEAU ACTIONS & ÉTAPES --- */
.tabs {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 16px;
}

.tab-btn {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text);
  font-size: 14px;
  font-weight: 400;
  cursor: pointer;
  text-align: left;
  transition: color 150ms var(--ease), background-color 150ms var(--ease), border-color 150ms var(--ease);
}

.tab-btn:hover {
  background: var(--surface-subtle);
}

.tab-btn.selected {
  border-color: var(--border-strong);
  background: var(--surface-subtle);
  font-weight: 500;
}

.tab-stat {
  font-size: 12px;
  color: var(--muted);
  font-weight: 500;
}

.detail {
  border-top: 1px solid var(--border);
  padding-top: 16px;
}

.detail-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  margin-bottom: 8px;
}
.detail-header h3 {
  margin: 0;
  width: 100%;
  font-size: 18px;
  line-height: 1.3;
  font-weight: 500;
  letter-spacing: -0.01em;
  word-break: break-word;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
}

.detail h3 {
  margin: 0;
  font-size: 16px;
  font-weight: 500;
}

.meta {
  color: var(--muted);
  font-size: 12px;
  margin: 4px 0 16px;
}

.step {
  border: 1px solid var(--border);
  background: var(--surface);
  border-radius: var(--radius-sm);
  padding: 12px;
  margin-bottom: 8px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  transition: border-color 150ms var(--ease);
}

.step:hover {
  border-color: var(--border-strong);
}

.step-left {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.step-check {
  width: 16px;
  height: 16px;
  margin-top: 4px;
  accent-color: #16a34a;
  cursor: pointer;
  flex-shrink: 0;
}

.step-date { font-size: 12px; font-weight: 500; }
.step-text { margin: 4px 0; font-size: 14px; font-weight: 400; color: var(--text); }
.step-text.is-done { text-decoration: line-through; color: var(--muted); }
.step-who { font-size: 12px; color: var(--muted); }

.st {
  border: none;
  border-radius: 6px;
  padding: 4px 8px;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  flex-shrink: 0;
}

.st-todo { background: var(--surface-subtle); color: var(--text-secondary); border: 1px solid var(--border); }
.st-doing { background: #ffedd5; color: #c2410c; }
.st-done { background: #dcfce7; color: #15803d; }

.empty-state {
  text-align: center;
  padding: 24px 16px;
  color: var(--muted);
  font-size: 14px;
  background: var(--surface-subtle);
  border-radius: var(--radius-sm);
}

/* --- FORMULAIRE --- */
.project-form { display: flex; flex-direction: column; gap: 16px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }

.field {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 12px;
  font-weight: 500;
  color: var(--text-secondary);
}

.field input, .field select {
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  padding: 8px 12px;
  font-size: 14px;
  font-family: inherit;
  color: var(--text);
  background: var(--surface);
  transition: border-color 150ms var(--ease);
}

.field input:focus, .field select:focus {
  outline: 2px solid var(--primary);
  outline-offset: 1px;
  border-color: var(--primary);
}

.steps-builder {
  border: 1px solid var(--border);
  background: var(--surface-subtle);
  border-radius: var(--radius-md);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.steps-builder-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  flex-wrap: wrap;
}

.steps-builder-head strong {
  font-size: 14px;
  font-weight: 500;
  color: var(--text);
  display: block;
}
