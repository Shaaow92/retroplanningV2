<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Rétroplanning E2C — Espace de suivi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="style.css" />
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.4/dist/jspdf.plugin.autotable.min.js"></script>
</head>
<body>
  <div id="authView" class="auth-shell">
    <div class="auth-card">
      <div class="auth-brand">
        <img src="E2Clogo.png" alt="Logo E2C" class="auth-logo" />
        <div>
          <h1>Rétroplanning E2C</h1>
          <p>Connectez-vous pour accéder à vos projets</p>
        </div>
      </div>
      <div class="auth-tabs">
        <button type="button" id="tabLogin" class="auth-tab active">Connexion</button>
        <button type="button" id="tabSignup" class="auth-tab">Créer un compte</button>
      </div>
      <form id="authForm" class="auth-form">
        <label class="field">
          <span>Identifiant</span>
          <input type="text" id="authUsername" placeholder="Ex. prenom.nom" minlength="3" required autocomplete="username" />
        </label>
        <label class="field">
          <span>Mot de passe</span>
          <input type="password" id="authPassword" placeholder="6 caractères minimum" minlength="6" required autocomplete="current-password" />
        </label>
        <div id="authFeedback" class="auth-feedback" hidden></div>
        <button type="submit" id="authSubmitBtn" class="btn-primary btn-full">Se connecter</button>
        <p style="margin:0.25rem 0 0;font-size:0.75rem;color:#64748b;text-align:center;">Espace interne E2C — Aucune adresse email requise.</p>
      </form>
    </div>
  </div>

  <div id="appView" hidden>
    <header class="topbar">
      <div class="topbar-inner">
        <div class="brand">
          <img src="E2Clogo.png" alt="Logo E2C" class="brand-logo-img" />
          <div>
            <strong>Rétroplanning E2C</strong>
            <small>Pilotage des actions &amp; échéances</small>
          </div>
        </div>

        <div class="user-menu">
          <span id="userEmailBadge" class="user-pill"></span>
          <button type="button" id="logoutBtn" class="btn-ghost">Déconnexion</button>
        </div>
      </div>
    </header>

    <main class="wrap">
      <section class="page-header">
        <div>
          <h1>Suivi des actions E2C</h1>
          <p>Partez de la date cible et remontez les étapes : cochez une tâche pour la valider ou cliquez sur son statut.</p>
        </div>
        <div class="header-actions io-toolbar">
          <button type="button" id="seedExamplesBtn" class="btn-secondary" hidden>+ Charger 3 projets exemples</button>
          <div class="io-dropdown">
            <button type="button" id="excelMenuBtn" class="btn-secondary btn-with-icon" aria-expanded="false" aria-controls="excelMenuPopover">
              <img src="excel.png" alt="" class="btn-ico" />
              <span>Excel</span>
              <span class="caret-ico" aria-hidden="true">▾</span>
            </button>
            <div id="excelMenuPopover" class="io-menu-popover" role="menu" hidden>
              <button type="button" id="exportActiveXlsxBtn" class="io-menu-item" role="menuitem">Exporter le projet actif</button>
              <button type="button" id="exportAllXlsxBtn" class="io-menu-item" role="menuitem">Exporter tous les projets</button>
              <button type="button" id="importXlsxBtn" class="io-menu-item" role="menuitem">Importer un fichier (.xlsx)</button>
              <div class="io-menu-divider" role="separator"></div>
              <button type="button" id="downloadTemplateXlsxBtn" class="io-menu-item is-muted" role="menuitem">Télécharger le modèle Excel</button>
            </div>
            <input type="file" id="importXlsxInput" accept=".xlsx,.xls" hidden />
          </div>
          <div class="io-dropdown">
            <button type="button" id="pdfMenuBtn" class="btn-secondary btn-with-icon" aria-expanded="false" aria-controls="pdfMenuPopover">
              <img src="pdf.png" alt="" class="btn-ico" />
              <span>PDF</span>
              <span class="caret-ico" aria-hidden="true">▾</span>
            </button>
            <div id="pdfMenuPopover" class="io-menu-popover" role="menu" hidden>
              <button type="button" id="downloadPdfBtn" class="io-menu-item" role="menuitem">Télécharger Retroplanning_E2C.pdf</button>
              <button type="button" id="printViewBtn" class="io-menu-item" role="menuitem">Imprimer la vue</button>
            </div>
          </div>
          <button type="button" id="openStagiairesModalBtn" class="btn-secondary btn-with-icon"><img src="stagiaires.png" alt="" style="width:18px;height:18px;object-fit:cover;object-position:center 20%;border-radius:999px;" /><span>Stagiaires · <span id="stagiairesCountBadge">0</span></span></button>
          <button type="button" class="btn-primary" data-open-modal>+ Nouveau projet</button>
        </div>
      </section>

      <div id="globalBanner" class="toast-banner" hidden></div>

      <section id="calendrier" class="layout">
        <div class="card">
          <div class="card-head">
            <div class="view-head-left">
              <div class="view-switcher" role="tablist" aria-label="Mode d'affichage">
                <button type="button" id="btnViewCal" class="switch-pill active" data-view-switch="calendar">Calendrier</button>
                <button type="button" id="btnViewGantt" class="switch-pill" data-view-switch="gantt">Gantt</button>
              </div>
              <div id="calNavControls" class="cal-nav-group">
                <button type="button" id="prevMonthBtn" class="btn-cal-nav" title="Mois précédent" aria-label="Mois précédent">‹</button>
                <h2 id="calMonthTitle" class="cal-month-title">Novembre 2026</h2>
                <button type="button" id="nextMonthBtn" class="btn-cal-nav" title="Mois suivant" aria-label="Mois suivant">›</button>
                <button type="button" id="todayMonthBtn" class="btn-today">Aujourd'hui</button>
              </div>
              <div id="ganttHeaderInfo" class="gantt-header-info" hidden>
                <h2 class="gantt-title">Vue globale Gantt</h2>
              </div>
            </div>
            <span id="globalProgress" class="badge-info">Aucun projet</span>
          </div>

          <div id="calendarViewContainer" class="cal-wrapper">
            <table class="cal">
              <thead>
                <tr>
                  <th>Lun</th><th>Mar</th><th>Mer</th><th>Jeu</th><th>Ven</th><th>Sam</th><th>Dim</th>
                </tr>
              </thead>
              <tbody id="calBody"></tbody>
            </table>
          </div>

          <div id="ganttViewContainer" class="gantt-wrapper" hidden></div>
        </div>

        <aside id="suivi" class="card">
          <div class="card-head">
            <h2>Actions en cours</h2>
            <span id="projectCount" class="muted-count">0 projet</span>
          </div>
          <div id="projectTabs" class="tabs"></div>
          <div id="detailBox" class="detail"></div>
        </aside>
      </section>
    </main>
  </div>

  <div id="projectModal" class="modal-backdrop" hidden role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <h2 id="modalTitle">Nouveau projet de rétroplanning</h2>
          <p class="card-subtitle">Cliquez sur les champs de date pour ouvrir le mini-calendrier</p>
        </div>
        <button type="button" id="closeModalBtn" class="btn-close-modal" aria-label="Fermer">✕</button>
      </div>
      <form id="addProjectForm" class="project-form modal-body">
        <div class="grid-3">
          <label class="field">
            <span>Nom du projet</span>
            <input type="text" id="projTitle" placeholder="Ex. Forum alternance" required />
          </label>
          <div class="field">
            <span>Date de début</span>
            <button type="button" id="projStartBtn" class="date-trigger" data-date-picker="start">
              <span class="cal-ico">📅</span>
              <span id="projStartLabel">24 nov. 2026</span>
            </button>
            <input type="hidden" id="projStartDate" value="2026-11-24" />
          </div>
          <div class="field">
            <span>Date de fin / Échéance</span>
            <button type="button" id="projEndBtn" class="date-trigger" data-date-picker="end">
              <span class="cal-ico">📅</span>
              <span id="projEndLabel">30 nov. 2026</span>
            </button>
            <input type="hidden" id="projEndDate" value="2026-11-30" />
          </div>
        </div>
        <div class="grid-2">
          <label class="field">
            <span>Responsable principal</span>
            <input type="text" id="projOwner" placeholder="Ex. Formateur référent" required />
          </label>
          <label class="field">
            <span>Couleur du repère</span>
            <select id="projColor">
              <option value="#2563eb">Bleu royal</option>
              <option value="#16a34a">Vert émeraude</option>
              <option value="#ea580c">Orange E2C</option>
              <option value="#7c3aed">Violet</option>
              <option value="#db2777">Rose framboise</option>
              <option value="#eab308">Jaune ambre</option>
            </select>
          </label>
        </div>
        <div class="steps-builder">
          <div class="steps-builder-head">
            <div>
              <strong>Étapes de préparation</strong>
              <span class="muted-small">Cliquez sur la date d'une étape pour la choisir sur le calendrier</span>
            </div>
            <button type="button" id="addStepRowBtn" class="btn-secondary">+ Ajouter une étape</button>
          </div>
          <div id="stepRowsContainer" class="step-rows"></div>
        </div>
        <div class="modal-footer">
          <button type="button" id="cancelModalBtn" class="btn-secondary">Annuler</button>
          <button type="submit" id="saveProjectBtn" class="btn-primary">Enregistrer le projet</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODALE DE PARTAGE & DROITS -->
  <div id="shareModal" class="modal-backdrop" hidden role="dialog" aria-modal="true" aria-labelledby="shareModalTitle">
    <div class="modal-card share-modal-card">
      <div class="modal-head">
        <div>
          <h2 id="shareModalTitle">Partager le projet</h2>
          <p id="shareProjectSubtitle" class="card-subtitle">Invitez un collègue E2C via son identifiant</p>
        </div>
        <button type="button" id="closeShareModalBtn" class="btn-close-modal" aria-label="Fermer">✕</button>
      </div>
      <div class="modal-body">
        <form id="shareAddForm" class="share-add-box">
          <div class="share-input-row">
            <input type="text" id="shareIdentifiantInput" placeholder="Identifiant du collègue (ex. marie.dupont)" required />
            <button type="submit" id="shareAddSubmitBtn" class="btn-primary">Ajouter</button>
          </div>
          <label class="perm-checkbox">
            <input type="checkbox" id="shareCanEditInput" checked />
            <span>Autoriser à <strong>modifier le projet et ajouter des étapes</strong> (sinon, peut uniquement cocher « Fait »)</span>
          </label>
          <div id="shareFeedback" class="auth-feedback" hidden></div>
        </form>

        <div class="share-list-section">
          <strong class="share-section-label">Personnes ayant accès</strong>
          <div id="shareCollaboratorsList" class="share-collab-list"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODALE VIVIER STAGIAIRES UP'2C -->
  <div id="stagiairesModal" class="modal-backdrop" hidden role="dialog" aria-modal="true" aria-labelledby="stagiairesModalTitle">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <h2 id="stagiairesModalTitle">Stagiaires du compte (Up'2C)</h2>
          <p class="card-subtitle">Importez un fichier Excel Up'2C, gérez votre liste et affectez les stagiaires voulus aux projets</p>
        </div>
        <div class="header-actions">
          <button type="button" id="importUp2cBtn" class="btn-secondary">Importer Excel Up'2C</button>
          <input type="file" id="importUp2cInput" accept=".xlsx,.xls,.csv" hidden />
          <button type="button" id="closeStagiairesModalBtn" class="btn-close-modal" aria-label="Fermer">✕</button>
        </div>
      </div>
      <div class="modal-body" style="display:flex;flex-direction:column;gap:1rem;">
        <form id="addStagiaireForm" class="stagiaire-add-row">
          <input type="text" id="stagPrenomInput" placeholder="Prénom" required />
          <input type="text" id="stagNomInput" placeholder="Nom" required />
          <input type="email" id="stagEmailInput" placeholder="E-mail (optionnel)" />
          <input type="text" id="stagTelInput" placeholder="Téléphone" />
          <button type="submit" class="btn-primary">+ Ajouter</button>
        </form>
        <div class="stagiaire-toolbar">
          <input type="search" id="stagiairesSearchInput" placeholder="Rechercher un stagiaire (nom, prénom, e-mail)..." />
          <span id="stagiairesModalCount" class="muted-count">0 stagiaire</span>
        </div>
        <div id="stagiairesListBox" class="stagiaires-list"></div>
      </div>
    </div>
  </div>

  <!-- MODALE AFFECTATION STAGIAIRES SUR LE PROJET ACTIF -->
  <div id="projectStagiairesModal" class="modal-backdrop" hidden role="dialog" aria-modal="true" aria-labelledby="projectStagModalTitle">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <h2 id="projectStagModalTitle">Stagiaires sur le projet</h2>
          <p id="projectStagSubtitle" class="card-subtitle">Cochez ou décochez les stagiaires à ajouter ou retirer de ce projet</p>
        </div>
        <button type="button" id="closeProjectStagModalBtn" class="btn-close-modal" aria-label="Fermer">✕</button>
      </div>
      <div class="modal-body" style="display:flex;flex-direction:column;gap:0.85rem;">
        <div class="stagiaire-toolbar">
          <input type="search" id="projectStagSearchInput" placeholder="Filtrer les stagiaires..." />
          <div class="header-actions">
            <button type="button" id="selectAllProjectStagBtn" class="btn-secondary">Tout cocher</button>
            <button type="button" id="clearAllProjectStagBtn" class="btn-secondary">Tout décocher</button>
          </div>
        </div>
        <div id="projectStagiairesChecklist" class="stagiaires-list"></div>
        <div class="modal-footer">
          <button type="button" id="cancelProjectStagBtn" class="btn-secondary">Annuler</button>
          <button type="button" id="saveProjectStagBtn" class="btn-primary">Enregistrer sur le projet</button>
        </div>
      </div>
    </div>
  </div>

  <!-- MINI-CALENDRIER INTERACTIF -->
  <div id="miniCalPopover" class="minical-popover" hidden>
    <div class="minical-head">
      <button type="button" id="miniPrevBtn" class="minical-nav" aria-label="Mois précédent">‹</button>
      <strong id="miniMonthTitle">Novembre 2026</strong>
      <button type="button" id="miniNextBtn" class="minical-nav" aria-label="Mois suivant">›</button>
    </div>
    <div class="minical-weekdays">
      <span>Lu</span><span>Ma</span><span>Me</span><span>Je</span><span>Ve</span><span>Sa</span><span>Di</span>
    </div>
    <div id="miniCalGrid" class="minical-grid"></div>
    <div class="minical-foot">
      <button type="button" id="miniTodayBtn" class="minical-today">Aujourd'hui</button>
      <span id="miniContextHint" class="minical-hint">Cliquez sur un jour</span>
    </div>
  </div>

  <script src="app.js"></script>
</body>
</html>
