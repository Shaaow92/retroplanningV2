:root {
  --bg: #f6f7f9;
  --surface: #ffffff;
  --surface-subtle: #f1f3f6;
  --text: #14171f;
  --text-secondary: #4b5565;
  --muted: #6b7280;
  --border: rgba(20, 23, 31, 0.09);
  --border-strong: rgba(20, 23, 31, 0.18);
  --primary: #ea580c;
  --primary-hover: #c2410c;
  --primary-soft: #fff7ed;
  --primary-border: rgba(234, 88, 12, 0.28);
  --shadow-sm: 0 1px 2px rgba(20, 23, 31, 0.05);
  --shadow-md: 0 8px 24px rgba(20, 23, 31, 0.08);
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --ease: cubic-bezier(0.22, 1, 0.36, 1);
}

* { box-sizing: border-box; }
[hidden] { display: none !important; }

body {
  margin: 0;
  font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  font-size: 14px;
  font-weight: 400;
  background: var(--bg);
  color: var(--text);
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
  -webkit-font-smoothing: antialiased;
}

img {
  max-width: 100%;
}

/* --- AUTHENTIFICATION --- */
.auth-shell {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: var(--bg);
}

.auth-card {
  width: 100%;
  max-width: 420px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: var(--shadow-md);
}

.auth-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}

.auth-logo {
  height: 44px;
  width: auto;
  object-fit: contain;
}

.auth-brand h1 {
  margin: 0;
  font-size: 20px;
  line-height: 1.25;
  font-weight: 600;
  color: var(--text);
}

.auth-brand p {
  margin: 4px 0 0;
  font-size: 13px;
  color: var(--muted);
}

.auth-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: var(--surface-subtle);
  padding: 4px;
  border-radius: var(--radius-sm);
  margin-bottom: 16px;
}

.auth-tab {
  border: none;
  background: transparent;
  padding: 8px 12px;
  font-size: 13px;
  font-weight: 500;
  color: var(--text-secondary);
  border-radius: 6px;
  cursor: pointer;
  transition: color 150ms var(--ease), background-color 150ms var(--ease);
}

.auth-tab.active {
  background: var(--surface);
  color: var(--text);
  box-shadow: var(--shadow-sm);
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.auth-feedback {
  font-size: 13px;
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  font-weight: 500;
}
.auth-feedback.error {
  background: #fef2f2;
  color: #b91c1c;
  border: 1px solid rgba(185, 28, 28, 0.22);
}
.auth-feedback.success {
  background: #f0fdf4;
  color: #15803d;
  border: 1px solid rgba(21, 128, 61, 0.22);
}

/* --- BOUTONS --- */
button {
  font-family: inherit;
}

.btn-primary,
.btn-secondary,
.btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 36px;
  padding: 0 14px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  white-space: nowrap;
  transition: background-color 150ms var(--ease), border-color 150ms var(--ease), color 150ms var(--ease), transform 120ms var(--ease);
}

.btn-primary:active,
.btn-secondary:active,
.btn-ghost:active {
  transform: scale(0.98);
}

.btn-primary {
  background: var(--primary);
  color: #ffffff;
  border: 1px solid var(--primary);
}

.btn-primary:hover {
  background: var(--primary-hover);
  border-color: var(--primary-hover);
}

.btn-secondary {
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--border-strong);
  box-shadow: var(--shadow-sm);
}

.btn-secondary:hover {
  background: var(--surface-subtle);
}

.btn-ghost {
  background: transparent;
  color: var(--text-secondary);
  border: 1px solid var(--border);
}

.btn-ghost:hover {
  background: var(--surface-subtle);
  color: var(--text);
}

.btn-full {
  width: 100%;
}

.btn-with-icon {
  padding: 0 12px;
}

.btn-ico {
  width: 16px;
  height: 16px;
  object-fit: contain;
  flex-shrink: 0;
  display: block;
}

.caret-ico {
  font-size: 11px;
  color: var(--muted);
  margin-left: 2px;
}

/* --- TOPBAR --- */
.topbar {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 20;
}

.topbar-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 12px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-logo-img {
  height: 36px;
  width: auto;
  object-fit: contain;
  display: block;
}

.brand strong {
  color: var(--text);
  font-size: 15px;
  font-weight: 600;
  line-height: 1.2;
}

.brand small {
  display: block;
  color: var(--muted);
  font-size: 12px;
}

.user-menu {
  display: flex;
  align-items: center;
  gap: 8px;
}

.user-pill {
  font-size: 12px;
  font-weight: 500;
  color: var(--text-secondary);
  background: var(--surface-subtle);
  padding: 6px 12px;
  border-radius: 6px;
  border: 1px solid var(--border);
}

/* --- LAYOUT & EN-TÊTE --- */
.wrap {
  max-width: 1280px;
  margin: 0 auto;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.page-header h1 {
  margin: 0;
  font-size: 24px;
  line-height: 1.2;
  font-weight: 600;
  letter-spacing: -0.015em;
  color: var(--text);
}

.page-header p {
  margin: 4px 0 0;
  font-size: 13px;
  color: var(--text-secondary);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.io-toolbar {
  align-items: center;
}

.io-dropdown {
  position: relative;
}

.io-menu-popover {
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  min-width: 220px;
  background: var(--surface);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-md);
  padding: 4px;
  z-index: 40;
  display: flex;
  flex-direction: column;
}

.io-menu-item {
  border: none;
  background: transparent;
  color: var(--text);
  font-size: 13px;
  font-weight: 500;
  text-align: left;
  padding: 8px 10px;
  border-radius: 6px;
  cursor: pointer;
}

.io-menu-item:hover {
  background: var(--surface-subtle);
}

.io-menu-item.is-muted {
  color: var(--text-secondary);
}

.io-menu-divider {
  height: 1px;
  background: var(--border);
  margin: 4px 0;
}

.toast-banner {
  background: var(--primary-soft);
  border: 1px solid var(--primary-border);
  color: var(--primary-hover);
  padding: 10px 16px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  font-weight: 500;
}

.layout {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  gap: 20px;
  align-items: start;
}

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 20px;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
}

.card-head h2 {
  margin: 0;
  font-size: 16px;
  font-weight: 600;
  color: var(--text);
}

.card-subtitle {
  margin: 4px 0 0;
  font-size: 12px;
  color: var(--muted);
}

.muted-small {
  font-size: 12px;
  color: var(--muted);
  display: block;
}

.muted-count {
  font-size: 12px;
  font-weight: 500;
  color: var(--muted);
  background: var(--surface-subtle);
  padding: 4px 8px;
  border-radius: 6px;
  border: 1px solid var(--border);
}

.badge-info {
  background: var(--surface-subtle);
  color: var(--text);
  border: 1px solid var(--border-strong);
  font-weight: 500;
  font-size: 12px;
  padding: 4px 10px;
  border-radius: 6px;
}

/* --- BARRE DE VUE & NAVIGATION CALENDRIER --- */
.view-head-left {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.view-switcher {
  display: inline-flex;
  background: var(--surface-subtle);
  padding: 4px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
}

.switch-pill {
  border: none;
  background: transparent;
  color: var(--text-secondary);
  font-size: 12px;
  font-weight: 500;
  padding: 6px 10px;
  border-radius: 6px;
  cursor: pointer;
}

.switch-pill.active {
  background: var(--surface);
  color: var(--text);
  box-shadow: var(--shadow-sm);
}

.cal-nav-group {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.cal-month-title,
.gantt-title {
  margin: 0;
  font-size: 16px;
  font-weight: 500;
  color: var(--text);
}

.btn-cal-nav,
.btn-today {
  height: 32px;
  border-radius: 6px;
  border: 1px solid var(--border-strong);
  background: var(--surface);
  color: var(--text);
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
}

.btn-cal-nav {
  width: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.btn-today {
  padding: 0 10px;
}

.btn-cal-nav:hover,
.btn-today:hover {
  background: var(--surface-subtle);
}

/* --- CALENDRIER --- */
.cal-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
}

table.cal {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
  border-radius: var(--radius-sm);
  overflow: hidden;
  border: 1px solid var(--border);
}

table.cal th {
  font-size: 12px;
  font-weight: 500;
  color: var(--text-secondary);
  background: var(--surface-subtle);
  padding: 8px 4px;
  border-bottom: 1px solid var(--border);
  border-right: 1px solid var(--border);
}

table.cal td {
  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  height: 88px;
  vertical-align: top;
  padding: 4px;
  background: var(--surface);
}

table.cal td.blank {
  background: var(--surface-subtle);
}

table.cal td.active-range {
  background: var(--primary-soft);
  box-shadow: inset 0 2px 0 var(--primary);
}

.dnum {
  font-size: 12px;
  font-weight: 500;
  margin-bottom: 4px;
  color: var(--text-secondary);
}

.mark {
  width: 100%;
  border: none;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 500;
  padding: 4px 6px;
  margin-bottom: 4px;
  text-align: left;
  cursor: pointer;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* --- PANNEAU ACTIONS & ÉTAPES --- */
.tabs {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 16px;
}

.tab-btn {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  text-align: left;
}

.tab-btn:hover {
  background: var(--surface-subtle);
}

.tab-btn.selected {
  border-color: var(--border-strong);
  background: var(--surface-subtle);
}

.tab-stat {
  font-size: 12px;
  color: var(--muted);
}

.detail {
  border-top: 1px solid var(--border);
  padding-top: 16px;
}

.detail-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  margin-bottom: 8px;
}

.detail-header h3,
.detail h3 {
  margin: 0;
  font-size: 16px;
  font-weight: 500;
  color: var(--text);
}

.meta {
  color: var(--muted);
  font-size: 12px;
  margin: 4px 0 12px;
}

.step {
  border: 1px solid var(--border);
  background: var(--surface);
  border-radius: var(--radius-sm);
  padding: 12px;
  margin-bottom: 8px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.step-left {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.step-check {
  width: 16px;
  height: 16px;
  margin-top: 4px;
  accent-color: #16a34a;
  cursor: pointer;
  flex-shrink: 0;
}

.step-date { font-size: 12px; font-weight: 500; }
.step-text { margin: 4px 0; font-size: 13px; color: var(--text); }
.step-text.is-done { text-decoration: line-through; color: var(--muted); }
.step-who { font-size: 12px; color: var(--muted); }

.st {
  border: none;
  border-radius: 6px;
  padding: 4px 8px;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  flex-shrink: 0;
}

.st-todo { background: var(--surface-subtle); color: var(--text-secondary); border: 1px solid var(--border); }
.st-doing { background: #ffedd5; color: #c2410c; }
.st-done { background: #dcfce7; color: #15803d; }

/* --- FORMULAIRES & MODALES --- */
.project-form { display: flex; flex-direction: column; gap: 16px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }

.field {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 12px;
  font-weight: 500;
  color: var(--text-secondary);
}

.field input,
.field select,
.date-trigger {
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  padding: 8px 12px;
  font-size: 13px;
  font-family: inherit;
  color: var(--text);
  background: var(--surface);
}

.date-trigger {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  text-align: left;
}

.field input:focus,
.field select:focus,
.date-trigger:focus {
  outline: 2px solid var(--primary);
  outline-offset: 1px;
  border-color: var(--primary);
}

.steps-builder {
  border: 1px solid var(--border);
  background: var(--surface-subtle);
  border-radius: var(--radius-md);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.steps-builder-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  flex-wrap: wrap;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(20, 23, 31, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  z-index: 60;
}

.modal-card {
  width: 100%;
  max-width: 720px;
  max-height: 90vh;
  overflow-y: auto;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
}

.modal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
}

.modal-head h2 {
  margin: 0;
  font-size: 16px;
  font-weight: 600;
}

.btn-close-modal {
  width: 32px;
  height: 32px;
  border-radius: 6px;
  border: 1px solid var(--border);
  background: var(--surface-subtle);
  color: var(--text);
  cursor: pointer;
}

.modal-body {
  padding: 20px;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  padding-top: 12px;
  border-top: 1px solid var(--border);
}

@media (max-width: 1024px) {
  .layout { grid-template-columns: 1fr; }
}

@media (max-width: 760px) {
  .grid-3, .grid-2 { grid-template-columns: 1fr; }
}

/* --- AVATARS STAGIAIRES & ACTIONS DÉTAIL --- */
.stag-avatar {
  width: 20px;
  height: 20px;
  object-fit: cover;
  object-position: center 20%;
  border-radius: 4px;
  flex-shrink: 0;
  display: block;
}

.stag-avatar-xs {
  width: 16px;
  height: 16px;
}

.stag-avatar-sm {
  width: 24px;
  height: 24px;
}

.stag-avatar-md {
  width: 32px;
  height: 32px;
}

.detail-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.btn-share-sm,
.btn-edit-sm,
.btn-danger-sm {
  height: 28px;
  padding: 0 10px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  border: 1px solid var(--border-strong);
  background: var(--surface);
  color: var(--text);
}

.btn-share-sm:hover,
.btn-edit-sm:hover {
  background: var(--surface-subtle);
}

.btn-danger-sm {
  color: #dc2626;
  border-color: rgba(220, 38, 38, 0.28);
}

.btn-danger-sm:hover {
  background: rgba(220, 38, 38, 0.08);
}

.role-pill {
  display: inline-block;
  font-size: 12px;
  font-weight: 500;
  padding: 4px 8px;
  border-radius: 6px;
  background: var(--surface-subtle);
  color: var(--text-secondary);
  border: 1px solid var(--border);
  margin-bottom: 8px;
}

.project-stag-summary {
  font-size: 12px;
  color: var(--text-secondary);
  background: var(--surface-subtle);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 8px 12px;
  margin-bottom: 12px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
}

.stag-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: var(--surface);
  border: 1px solid var(--border-strong);
  border-radius: 6px;
  padding: 2px 8px;
  font-size: 12px;
  color: var(--text);
}

.stag-chip-rm {
  border: none;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  padding: 0 2px;
  font-size: 13px;
  line-height: 1;
}

.stag-chip-rm:hover {
  color: var(--text);
}

.link-inline-btn {
  border: none;
  background: transparent;
  color: var(--primary);
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  padding: 0;
  text-decoration: underline;
}

.stagiaires-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 360px;
  overflow-y: auto;
}

.stagiaire-row,
.stagiaire-check-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 12px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface-subtle);
}

.stagiaire-check-item {
  justify-content: flex-start;
  cursor: pointer;
}

.stagiaire-main {
  flex: 1;
  min-width: 0;
}

.stagiaire-sub {
  font-size: 12px;
  color: var(--muted);
}

.stagiaire-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.stag-project-pill {
  font-size: 12px;
  color: var(--text-secondary);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 2px 8px;
}

.stagiaire-add-row,
.stagiaire-toolbar,
.share-input-row {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
